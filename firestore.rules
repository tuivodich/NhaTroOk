rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return isSignedIn() && userRole() == 'admin'; }
    function isStaff() { return isSignedIn() && userRole() in ['admin','staff']; }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }
    match /properties/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /rooms/{id} {
      allow read: if isSignedIn() || resource.data.published == true;
      allow write: if isAdmin();
      // Staff: chỉ đổi status vacant <-> occupied
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((resource.data.status == 'vacant' && request.resource.data.status == 'occupied')
         || (resource.data.status == 'occupied' && request.resource.data.status == 'vacant'));
    }
    match /inquiries/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['name','phone','status','createdAt','roomId'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.phone.size() <= 30
        && request.resource.data.status == 'new'
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.status == 'vacant';
      allow read, update, delete: if isStaff();
    }
    // [PHASE4C] Khách chỉ đọc được dữ liệu của chính mình (userId == uid), do staff liên kết tài khoản.
    match /tenants/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /contracts/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    // [PHASE4C] Yêu cầu sửa chữa: khách tạo/đọc của mình, staff xử lý
    match /maintenanceRequests/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['userId','tenantId','roomId','title','description','status','createdAt','updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 1000));
      allow update: if isStaff();
      allow delete: if isAdmin();
    }
    match /_counters/{name} {
      allow read, write: if isStaff();
    }
    // [PHASE4B] Hóa đơn: staff được tạo (lập hóa đơn tháng); sửa/xóa chỉ admin
    match /invoices/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }
    match /meterReadings/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /staffInvites/{email} {
      allow get: if isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
      allow list, create, update, delete: if isAdmin();
    }
  }
}
