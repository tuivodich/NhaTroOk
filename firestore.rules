rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return isSignedIn() && userRole() == 'admin'; }
    function isStaff() { return isSignedIn() && userRole() in ['admin','staff']; }

    // [PHASE4D] users: không còn mở cho mọi người dùng đọc; không tự nâng quyền.
    match /users/{uid} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == uid);
      // Tự tạo hồ sơ của mình: chỉ vai trò tenant, hoặc staff khi email có lời mời còn hiệu lực. Không bao giờ admin.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','email','displayName','photoURL','role','createdAt','lastLoginAt','active'])
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.role == 'tenant'
            || (request.resource.data.role == 'staff'
                && request.auth.token.email != null
                && exists(/databases/$(database)/documents/staffInvites/$(request.auth.token.email.lower()))
                && get(/databases/$(database)/documents/staffInvites/$(request.auth.token.email.lower())).data.get('active', true) != false));
      // Admin sửa mọi thứ; người dùng chỉ sửa thông tin hiển thị của mình, không đổi vai trò.
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','lastLoginAt']));
    }
    match /properties/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // [PHASE4E] rooms: công khai chỉ khi published; khách chỉ đọc phòng mình đang ở (residentUids); staff đọc hết.
    match /rooms/{id} {
      allow read: if resource.data.published == true
        || isStaff()
        || (isSignedIn() && request.auth.uid in resource.data.get('residentUids', []));
      allow write: if isAdmin();
      // Staff: chỉ đổi status (vacant <-> occupied) và/hoặc duy trì residentUids (khách được xem phòng)
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','residentUids'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || (resource.data.status == 'vacant' && request.resource.data.status == 'occupied')
            || (resource.data.status == 'occupied' && request.resource.data.status == 'vacant'));
    }
    match /inquiries/{id} {
      allow create: if
        request.resource.data.keys().hasAll(['name','phone','status','createdAt','roomId'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.phone.size() <= 30
        && request.resource.data.status == 'new'
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.status == 'vacant';
      allow read, update, delete: if isStaff();
    }
    // [PHASE4C] Khách chỉ đọc được dữ liệu của chính mình (userId == uid), do staff liên kết tài khoản.
    match /tenants/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /contracts/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    // [PHASE4C] Yêu cầu sửa chữa: khách tạo/đọc của mình, staff xử lý
    match /maintenanceRequests/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['userId','tenantId','roomId','title','description','status','createdAt','updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 1000));
      allow update: if isStaff();
      allow delete: if isAdmin();
    }
    match /_counters/{name} {
      allow read, write: if isStaff();
    }
    // [PHASE4B] Hóa đơn: staff được tạo (lập hóa đơn tháng); sửa/xóa chỉ admin
    match /invoices/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isStaff();
      // Staff chỉ được đánh dấu "đã trả"; sửa nội dung/xóa là việc của admin
      allow update: if isAdmin()
        || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','paidAt'])
            && request.resource.data.status == 'paid');
      allow delete: if isAdmin();
    }
    // [PHASE4D] Khách báo đã chuyển khoản; staff xác nhận/từ chối. Khách không sửa được hóa đơn.
    match /paymentReports/{id} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['invoiceId','userId','tenantId','roomId','amount','note','status','createdAt','updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.invoiceId is string
        && id == 'pr_' + request.resource.data.invoiceId
        && get(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.status != 'paid'
        && request.resource.data.amount == get(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.total
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 300));
      allow update: if (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','staffNote','reviewedBy','updatedAt'])
            && request.resource.data.status in ['confirmed','rejected'])
        || (isSignedIn() && resource.data.userId == request.auth.uid
            && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','note','updatedAt'])
            && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 300)));
      allow delete: if isAdmin();
    }
    // [PHASE5] Nhật ký nhắc nợ: staff ghi mỗi lần nhắc; script email tự động ghi bằng Admin SDK (không qua rules)
    match /reminderLogs/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['tenantId','roomId','invoiceIds','channel','by','day','at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.channel in ['copy','zalo','sms','email']
        && request.resource.data.roomId is string
        && request.resource.data.invoiceIds is list
        && request.resource.data.invoiceIds.size() <= 50
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10;
      allow delete: if isAdmin();
    }
    match /meterReadings/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    // Thông tin chuyển khoản: khách (đã đăng nhập) đọc được để biết chuyển đi đâu
    match /settings/payment {
      allow read: if isSignedIn();
    }
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    // [PHASE4E] auditLogs: chỉ staff/admin ghi, đúng danh tính, đúng thời điểm máy chủ; không ai sửa được.
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['action','message','target','uid','email','role','at','count'])
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 60
        && request.resource.data.at == request.time
        && (!('uid' in request.resource.data) || request.resource.data.uid == null || request.resource.data.uid == request.auth.uid)
        && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 500));
      allow delete: if isAdmin();
    }
    match /staffInvites/{email} {
      allow get: if isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
      // Người được mời chỉ được ghi dấu đã nhận lời mời của chính email mình
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedAt','acceptedBy']));
      allow list, create, delete: if isAdmin();
    }
  }
}
